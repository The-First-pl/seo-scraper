# Skopiuj do .env i uzupełnij wartości

# Flask
SECRET_KEY=zmien-na-losowy-string
FLASK_ENV=development

# Google OAuth — stwórz "Web application" credentials w Google Cloud Console
# Redirect URI: http://localhost:5000/auth/callback (dev) lub https://twoja-domena/auth/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL aplikacji (bez trailing slash)
APP_URL=http://localhost:5000

# Anthropic — opcjonalne, użytkownik może wpisać w formularzu
ANTHROPIC_API_KEY=sk-ant-...
